{
  "name": "gpt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install --prefer-offline --loglevel warn",
    "dev": "vite",
    "build": "tsgo && vite build",
    "test": "vitest run",
    "prepare": "simple-git-hooks",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e/**/*.spec.ts",
    "test:visual": "playwright test --config=playwright-visual.config.ts",
    "test:visual:ci": "playwright test --config=playwright-visual.config.ts tests/visual/homepage.visual.spec.ts",
    "test:visual:ui": "playwright test --config=playwright-visual.config.ts --ui",
    "test:visual:update": "playwright test --config=playwright-visual.config.ts --update-snapshots",
    "test:accessibility": "playwright test tests/accessibility/**/*.spec.ts",
    "test:performance": "playwright test --config=playwright-performance.config.ts",
    "test:aggregate": "tsx scripts/aggregate-test-results.ts",
    "fix": "eslint --fix",
    "lint": "eslint",
    "preview": "vite preview"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,jsx,tsx,css,md,json,toml,yaml,yml}": [
      "eslint --fix"
    ]
  },
  "prettier": "@bfra.me/prettier-config/120-proof",
  "dependencies": {
    "@heroui-v3/react": "npm:@heroui/react@3.2.7",
    "@heroui-v3/styles": "npm:@heroui/styles@3.2.7",
    "@heroui/react": "2.8.10",
    "@internationalized/date": "3.12.4",
    "@langchain/anthropic": "1.6.0",
    "@langchain/core": "1.3.1",
    "@langchain/langgraph": "1.5.3",
    "@langchain/openai": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@monaco-editor/react": "4.7.0",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "clsx": "2.1.1",
    "dexie": "4.4.7",
    "file-saver": "2.0.5",
    "jszip": "3.10.2",
    "langchain": "1.6.0",
    "lru-cache": "11.5.3",
    "lucide-react": "0.577.0",
    "mammoth": "1.13.0",
    "next-themes": "0.4.6",
    "openai": "6.49.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "react-swipeable": "7.0.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@bfra.me/eslint-config": "0.54.0",
    "@bfra.me/prettier-config": "0.16.13",
    "@bfra.me/tsconfig": "0.13.2",
    "@eslint-react/eslint-plugin": "2.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/file-saver": "2.0.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "1.6.28",
    "autoprefixer": "10.6.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.6",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "lighthouse": "13.6.0",
    "lint-staged": "16.4.0",
    "playwright-lighthouse": "4.0.0",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@11.28.9"
}
